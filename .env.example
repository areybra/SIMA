# --- Django ---
SECRET_KEY=django-insecure-ganti-dengan-key-acak-panjang
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# --- Database ---
# Pilihan: sqlite (default dev) | postgres / supabase | mysql / mariadb
# Default: sqlite — langsung jalan tanpa DB server
DB_ENGINE=sqlite

# Contoh untuk Supabase / Postgres (pooler 6543 direkomendasikan):
# DB_ENGINE=postgres
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=isi-password-db-supabase
# DB_SSLMODE=require

# Contoh untuk MySQL / MariaDB:
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=sima
# DB_USER=root
# DB_PASSWORD=isi-password-mysql

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sima
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
