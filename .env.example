# =============================================================================
# SIMA — Sistem Interaktif Manajemen Atlet | Environment Variables
# =============================================================================
# Cara pakai:
#   cp .env.example .env
#   # Edit SECRET_KEY & DB sesuai kebutuhan, lalu:
#   python manage.py migrate
#
# Generate SECRET_KEY baru:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =============================================================================

# --- Django Core -------------------------------------------------------------
SECRET_KEY=django-insecure-ganti-dengan-key-acak-panjang-min-50-karakter
DEBUG=True
# Lokal: 127.0.0.1,localhost,testserver
# Vercel: tambahkan .vercel.app atau domain custom (atau set di dashboard Vercel)
# Contoh Vercel: ALLOWED_HOSTS=.vercel.app,sima-xxx.vercel.app,yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# CSRF untuk https — isi jika pakai Vercel/domain custom (wajib https://)
# Contoh: CSRF_TRUSTED_ORIGINS=https://sima-xxx.vercel.app,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# Cara 1 (DIREKOMENDASIKAN untuk Railway/Vercel/Supabase): satu URL
#   DATABASE_URL=postgresql://user:pass@host:port/dbname
#   Jika DATABASE_URL diisi, ia diprioritaskan (DB_ENGINE/DB_HOST diabaikan)
#   Deploy Vercel: sudah otomatis fallback ke Supabase pooler (IPv4) jika tidak di-set
#   PENTING Supabase: JANGAN pakai db.*.supabase.co:5432 (IPv6-only → Cannot assign requested address di Vercel)
#   Pakai POOLER (IPv4): aws-0-ap-southeast-1.pooler.supabase.com:6543 + user postgres.<project_ref>
#   Aktif (otomatis dipakai saat deploy jika DATABASE_URL kosong & VERCEL=1):
DATABASE_URL=postgresql://postgres.mchmxwxjrlyywutbrppj:radjawali2009%21@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#   Contoh Railway (alternatif):
#   DATABASE_URL=postgresql://postgres:yQoeYmoEyoAIqkoSdmcAPYrqEsdMoytO@thomas.proxy.rlwy.net:24876/sima
#   Jika pakai direct Supabase host db.*.supabase.co:5432, kode akan auto-rewrite ke pooler di atas

# Cara 2 (opsional): terpisah — pilihan engine: sqlite | postgres | supabase | mysql | mariadb
#   sqlite  → dev tanpa server, file db.sqlite3 (default)
#   postgres/supabase → production Supabase/Postgres
#   mysql/mariadb    → production MySQL/MariaDB
DB_ENGINE=sqlite

# --- Postgres / Supabase (aktifkan jika DB_ENGINE=postgres) -----------------
# Supabase pooler direkomendasikan: port 6543
# DB_ENGINE=postgres
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=isi-password-supabase
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60

# --- MySQL / MariaDB (aktifkan jika DB_ENGINE=mysql) ------------------------
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=sima
# DB_USER=root
# DB_PASSWORD=isi-password-mysql
# DB_CONN_MAX_AGE=60

# --- Fallback values (dipakai jika DB_ENGINE=sqlite tidak butuh) ------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sima
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
