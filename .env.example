# =============================================================================
# SIMA — Sistem Interaktif Manajemen Atlet | Environment Variables
# =============================================================================
# Cara pakai:
#   cp .env.example .env
#   # Edit SECRET_KEY & DB sesuai kebutuhan, lalu:
#   python manage.py migrate
#
# Generate SECRET_KEY baru:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =============================================================================

# --- Django Core -------------------------------------------------------------
SECRET_KEY=django-insecure-ganti-dengan-key-acak-panjang-min-50-karakter
DEBUG=True
# Lokal: 127.0.0.1,localhost,testserver
# Vercel: tambahkan .vercel.app atau domain custom (atau set di dashboard Vercel)
# Contoh Vercel: ALLOWED_HOSTS=.vercel.app,sima-xxx.vercel.app,yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# CSRF untuk https — isi jika pakai Vercel/domain custom (wajib https://)
# Contoh: CSRF_TRUSTED_ORIGINS=https://sima-xxx.vercel.app,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# Cara 1 (DIREKOMENDASIKAN): satu URL
#   DATABASE_URL=mysql://user:pass@host:port/dbname
#   Jika DATABASE_URL diisi, ia diprioritaskan (DB_ENGINE/DB_HOST diabaikan)
#   Contoh MySQL: mysql://root:password@localhost:3306/sima
#   Contoh Railway MySQL: mysql://root:password@mysql.railway.internal:3306/sima
#   Jika DATABASE_URL diisi, ia diprioritaskan (DB_ENGINE/DB_HOST diabaikan)
DATABASE_URL=mysql://root:password@localhost:3306/sima

# Cara 2 (opsional): terpisah — pilihan engine: sqlite | mysql | mariadb
#   sqlite  → dev tanpa server, file db.sqlite3 (default)
#   mysql/mariadb    → production MySQL/MariaDB
DB_ENGINE=sqlite

# --- MySQL / MariaDB (aktifkan jika DB_ENGINE=mysql) ------------------------
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=sima
# DB_USER=root
# DB_PASSWORD=isi-password-mysql
# DB_CONN_MAX_AGE=60

# --- Fallback values (dipakai jika DB_ENGINE=sqlite tidak butuh) ------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sima
DB_USER=root
DB_PASSWORD=
DB_CONN_MAX_AGE=60
