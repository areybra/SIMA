# =============================================================================
# SIMA — Sistem Interaktif Manajemen Atlet | Environment Variables
# =============================================================================
# Cara pakai:
#   cp .env.example .env
#   # Edit SECRET_KEY & DB sesuai kebutuhan, lalu:
#   python manage.py migrate
#
# Generate SECRET_KEY baru:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =============================================================================

# --- Django Core -------------------------------------------------------------
SECRET_KEY=django-insecure-ganti-dengan-key-acak-panjang-min-50-karakter
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# --- Database ---------------------------------------------------------------
# Pilihan engine: sqlite | postgres | supabase | mysql | mariadb
#   sqlite  → dev tanpa server, file db.sqlite3 (default)
#   postgres/supabase → production Supabase/Postgres
#   mysql/mariadb    → production MySQL/MariaDB
DB_ENGINE=sqlite

# --- Postgres / Supabase (aktifkan jika DB_ENGINE=postgres) -----------------
# Supabase pooler direkomendasikan: port 6543
# DB_ENGINE=postgres
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=isi-password-supabase
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60

# --- MySQL / MariaDB (aktifkan jika DB_ENGINE=mysql) ------------------------
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=sima
# DB_USER=root
# DB_PASSWORD=isi-password-mysql
# DB_CONN_MAX_AGE=60

# --- Fallback values (dipakai jika DB_ENGINE=sqlite tidak butuh) ------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sima
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
